<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo oscuro con luces suaves detrás del vidrio -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#07070A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.08"
                android:endColor="#00E8FF5A"
                android:gradientRadius="70%p"
                android:startColor="#33E8FF5A"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.95"
                android:centerY="0.65"
                android:endColor="#007C5CFF"
                android:gradientRadius="80%p"
                android:startColor="#407C5CFF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.2"
                android:centerY="1.0"
                android:endColor="#0000C2FF"
                android:gradientRadius="60%p"
                android:startColor="#2600C2FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
