<?xml version="1.0" encoding="utf-8"?>
<!-- Vidrio: base oscura translúcida + brillo superior + borde luminoso -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C141418" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#05FFFFFF"
                android:startColor="#29FFFFFF" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</layer-list>
