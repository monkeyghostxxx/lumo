<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lumo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
    </style>

    <style name="Theme.Lumo.Car" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- Botones del dock de vidrio -->
    <style name="GlassIcon">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/bg_glass_circle</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">#FFFFFF</item>
    </style>

    <style name="GlassIcon.Solid">
        <item name="android:background">@drawable/bg_circle_solid</item>
        <item name="android:tint">#000000</item>
        <item name="android:padding">15dp</item>
    </style>
</resources>
